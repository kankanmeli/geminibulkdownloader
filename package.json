{
  "name": "gemini-bulk-image-downloader",
  "version": "5.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint extension/*.js scripts/*.js tests/*.js",
    "format": "prettier -w extension/*.js scripts/*.js tests/*.js",
    "test": "node tests/utils.test.js && node tests/background.test.js && node tests/integration.test.js",
    "test:unit": "node tests/utils.test.js",
    "test:background": "node tests/background.test.js",
    "test:integration": "node tests/integration.test.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "sync-version": "node scripts/sync-version.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2"
  }
}
