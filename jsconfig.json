{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "commonjs",
    "noEmit": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "strict": false,
    "types": ["node"]
  },
  "include": ["extension/utils.js", "tests/utils.test.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "extension/content.js", "extension/background.js", "eslint.config.mjs"]
}
